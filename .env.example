# =============================================
# TECHVALIDATOR AI — Configuración
# =============================================
# Copia este archivo como .env y rellena las claves:
#   cp .env.example .env

# ─── Gemini (clasificación + análisis de video) ───
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_aqui

# Puerto del servidor (opcional, default: 3000)
PORT=3000

# ─── Yahoo Mail (IMAP) ───
# 1. Entra a account.yahoo.com → Seguridad → Contraseñas de aplicaciones
# 2. Genera una App Password (NO uses tu contraseña normal)
# 3. Pégala aquí
YAHOO_EMAIL=tu_email@yahoo.com.au
YAHOO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993

# ─── Google Drive (OAuth2) ───
# 1. Ve a https://console.cloud.google.com/apis/credentials
# 2. Crea credenciales OAuth 2.0 (tipo "Aplicación web")
# 3. Añade redirect URI: http://localhost:3000/api/auth/google/callback
#    (en producción: https://tu-dominio/api/auth/google/callback)
# 4. Activa la API de Google Drive en el proyecto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Carpeta raíz en Drive donde caerán las clasificaciones (se crea sola si no existe)
DRIVE_ROOT_FOLDER=Inbox-Classified

# ─── Basic Auth (opcional, pero requerido antes de exponer a internet) ───
# Si ambas están definidas, toda la app pide usuario/contraseña.
# BASIC_AUTH_USER=isa
# BASIC_AUTH_PASS=algo-largo-y-único
